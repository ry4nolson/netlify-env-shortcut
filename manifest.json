{
  "manifest_version": 3,
  "name": "Netlify Env Vars Shortcut",
  "version": "1.0.0",
  "description": "Adds an Environment Variables shortcut to the Netlify site nav",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["https://app.netlify.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
